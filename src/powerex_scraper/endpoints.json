{
  "baseUrl": "https://web-api.tp.entsoe.eu",
  "endpoints": [
    {
      "id": "entsoe-generation-forecast-dayahead",
      "path": "/api",
      "query": {
        "securityToken": "${env:API_KEY}",
        "documentType": "A71",
        "processType": "A01",
        "in_Domain": "10YSK-SEPS-----K",
        "periodStart": "${date:%Y%m%d%H%M:P1D}",
        "periodEnd": "${date:%Y%m%d%H%M:P2D}"
      },
      "responseFormat": "xml",
      "xslt": "entsoe-forecast.xslt",
      "timezone": "Europe/Bratislava",
      "keyDateOffsetDays": 1
    },
    {
      "id": "entsoe-generation-actual-perunit",
      "path": "/api",
      "query": {
        "securityToken": "${env:API_KEY}",
        "documentType": "A73",
        "processType": "A16",
        "in_Domain": "10YSK-SEPS-----K",
        "periodStart": "${date:%Y%m%d%H%M:-P1D}",
        "periodEnd": "${date:%Y%m%d%H%M:P0D}"
      },
      "responseFormat": "xml",
      "xslt": "entsoe-perunit.xslt",
      "timezone": "Europe/Bratislava",
      "keyDateOffsetDays": -1
    }
  ]
}